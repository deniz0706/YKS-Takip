selectAllLearningOutcomes:
SELECT * FROM learning_outcomes ORDER BY exam_type, subject, topic, title ASC;

selectLearningOutcomeById:
SELECT * FROM learning_outcomes WHERE id = ?;

insertLearningOutcome:
INSERT INTO learning_outcomes (id, exam_type, subject, topic, title, completed, review_requested, wrong_count, acknowledged_wrong_count, next_review_date, review_level, last_reviewed_date, custom, completed_date, completed_subtopics)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteLearningOutcome:
DELETE FROM learning_outcomes WHERE id = ?;

selectAllQuestionCards:
SELECT * FROM question_cards ORDER BY created_at ASC;

selectQuestionCardsByOutcome:
SELECT * FROM question_cards WHERE outcome_id = ? ORDER BY created_at ASC;

insertQuestionCard:
INSERT INTO question_cards (id, outcome_id, title, notes, status, created_at, due_date, review_count, photos)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteQuestionCard:
DELETE FROM question_cards WHERE id = ?;
