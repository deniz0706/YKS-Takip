<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_horizontal"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingTop="@dimen/space_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Çalışma"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="@color/on_background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bugünkü çalışma durumunu takip et."
            android:textSize="@dimen/text_body"
            android:textColor="@color/on_surface_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bugün çözülen"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/on_surface_secondary" />

                <TextView
                    android:id="@+id/tvStudyQuestions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_background" />

            </LinearLayout>

            <View
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Çalışma süresi"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/on_surface_secondary" />

                <TextView
                    android:id="@+id/tvStudyTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0 dk"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_background" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStudyGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hedef: —"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_surface_secondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnEditToday"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center"
            android:text="Bugünü Düzenle"
            android:textStyle="bold"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_button_secondary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xl"
    android:text="Ders Programı"
    android:textSize="@dimen/text_body"
    android:textColor="@color/on_surface_secondary" />

<LinearLayout
    android:id="@+id/planDaySelector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_s"
    android:orientation="horizontal" />

<TextView
    android:id="@+id/btnAddPlan"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginTop="@dimen/space_s"
    android:gravity="center"
    android:text="+ Ders Ekle"
    android:textStyle="bold"
    android:textColor="@color/on_background"
    android:background="@drawable/bg_button_secondary"
    android:clickable="true"
    android:focusable="true" />

<LinearLayout
    android:id="@+id/planList"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_s"
    android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="İlerleme"
            android:textSize="@dimen/text_body"
            android:textColor="@color/on_surface_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chartMetricQuestions"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Soru"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_toggle"
                    android:textColor="@color/on_background" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/chartMetricTime"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Süre"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_toggle"
                    android:textColor="@color/on_background" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chartRange7"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="7 Gün"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_toggle"
                    android:textColor="@color/on_background" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/chartRange30"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="30 Gün"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_toggle"
                    android:textColor="@color/on_background" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/chartRangeAll"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Tüm Zamanlar"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_toggle"
                    android:textColor="@color/on_background" />

            </LinearLayout>

            <com.deniz0706.ykstakip.ui.statistics.LineChartView
                android:id="@+id/studyChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />

            <TextView
                android:id="@+id/tvStudyChartEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Henüz çalışma verisi yok."
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_surface_secondary"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="Genel Durum"
            android:textSize="@dimen/text_body"
            android:textColor="@color/on_surface_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/tvTotalQuestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toplam soru: 0"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

            <TextView
                android:id="@+id/tvTotalStudyTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="Toplam çalışma: 0 dk"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

            <TextView
                android:id="@+id/tvAverageQuestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="Günlük ortalama soru: 0"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

            <TextView
                android:id="@+id/tvAverageStudyTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="Günlük ortalama çalışma: 0 dk"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

            <TextView
                android:id="@+id/tvGoalDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="Hedef tutan gün: 0"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

            <TextView
                android:id="@+id/tvBestQuestionDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="En çok soru: —"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

            <TextView
                android:id="@+id/tvBestStudyDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="En uzun çalışma: —"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
