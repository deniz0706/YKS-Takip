<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingTop="@dimen/space_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="İstatistikler"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="@color/on_background" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/toggleTyt"
                android:layout_width="88dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="TYT"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_toggle"
                android:textColor="@color/on_background" />

            <TextView
                android:id="@+id/toggleAyt"
                android:layout_width="88dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="AYT"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_toggle"
                android:textColor="@color/on_background" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modeToplam"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Toplam Deneme"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="@drawable/bg_pill_toggle"
                android:textColor="@color/on_background" />

            <TextView
                android:id="@+id/modeBranch"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="Branş"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="@drawable/bg_pill_toggle"
                android:textColor="@color/on_background" />
        </LinearLayout>

        <TextView
            android:id="@+id/selectorBranch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:gravity="center_vertical"
            android:textColor="@color/on_background"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/selectorMetric"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:gravity="center_vertical"
            android:textColor="@color/on_background"
            android:textSize="@dimen/text_body"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/range5"
                style="@style/RangeChip"
                android:text="Son 5" />

            <TextView
                android:id="@+id/range10"
                style="@style/RangeChip"
                android:text="Son 10"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/range20"
                style="@style/RangeChip"
                android:text="Son 20"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/rangeAll"
                style="@style/RangeChip"
                android:text="Tümü"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_m"
            android:layout_marginTop="@dimen/space_m">

            <com.deniz0706.ykstakip.ui.statistics.LineChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvEmptyChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_m"
                android:gravity="center"
                android:text="Bu istatistik için henüz yeterli veri yok."
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal">

            <LinearLayout style="@style/StatMini">
                <TextView
                    style="@style/StatMiniLabel"
                    android:text="Son" />
                <TextView
                    android:id="@+id/tvSon"
                    style="@style/StatMiniValue" />
            </LinearLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout style="@style/StatMini">
                <TextView
                    style="@style/StatMiniLabel"
                    android:text="Ortalama" />
                <TextView
                    android:id="@+id/tvOrt"
                    style="@style/StatMiniValue" />
            </LinearLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout style="@style/StatMini">
                <TextView
                    style="@style/StatMiniLabel"
                    android:text="En Yüksek" />
                <TextView
                    android:id="@+id/tvMax"
                    style="@style/StatMiniValue" />
            </LinearLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout style="@style/StatMini">
                <TextView
                    style="@style/StatMiniLabel"
                    android:text="En Düşük" />
                <TextView
                    android:id="@+id/tvMin"
                    style="@style/StatMiniValue" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/selectorAytField"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:gravity="center_vertical"
            android:textColor="@color/on_background"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/rankingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_padding"
            android:layout_marginTop="@dimen/space_m">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tahmini Sıralama"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

            <TextView
                android:id="@+id/tvRankingEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textColor="@color/on_surface_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal">

                <LinearLayout style="@style/StatMini">
                    <TextView
                        style="@style/StatMiniLabel"
                        android:text="Son" />
                    <TextView
                        android:id="@+id/tvRankingLast"
                        style="@style/StatMiniValue"
                        android:text="—" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <LinearLayout style="@style/StatMini">
                    <TextView
                        style="@style/StatMiniLabel"
                        android:text="Son 3 Ort." />
                    <TextView
                        android:id="@+id/tvRankingAvg3"
                        style="@style/StatMiniValue"
                        android:text="—" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <LinearLayout style="@style/StatMini">
                    <TextView
                        style="@style/StatMiniLabel"
                        android:text="Son 5 Ort." />
                    <TextView
                        android:id="@+id/tvRankingAvg5"
                        style="@style/StatMiniValue"
                        android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal">

                <LinearLayout style="@style/StatMini">
                    <TextView
                        style="@style/StatMiniLabel"
                        android:text="En İyi" />
                    <TextView
                        android:id="@+id/tvRankingBest"
                        style="@style/StatMiniValue"
                        android:text="—" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <LinearLayout style="@style/StatMini">
                    <TextView
                        style="@style/StatMiniLabel"
                        android:text="En Kötü" />
                    <TextView
                        android:id="@+id/tvRankingWorst"
                        style="@style/StatMiniValue"
                        android:text="—" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

                    <LinearLayout
            android:id="@+id/rankingTrendCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_padding"
            android:layout_marginTop="@dimen/space_m">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sıralama Trendi"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

            <TextView
                android:id="@+id/tvRankingTrendInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Küçük sıralama değeri grafik üzerinde daha yukarıdadır."
                android:textSize="12sp"
                android:textColor="@color/on_surface_secondary" />

            <com.deniz0706.ykstakip.ui.statistics.LineChartView
                android:id="@+id/rankingChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />

            <TextView
                android:id="@+id/tvEmptyRankingChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_m"
                android:gravity="center"
                android:text="Sıralama trendi için henüz yeterli veri yok."
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/weakSpotCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_padding"
            android:layout_marginTop="@dimen/space_m"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zayıf Halka"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Son 5 deneme"
                android:textSize="12sp"
                android:textColor="@color/on_surface_secondary" />

            <LinearLayout
                android:id="@+id/weakSpotList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_s" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
