        <LinearLayout
            android:id="@+id/rankingTrendCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_padding"
            android:layout_marginTop="@dimen/space_m">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sıralama Trendi"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                android:textColor="@color/on_background" />

            <TextView
                android:id="@+id/tvRankingTrendInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Küçük sıralama değeri grafik üzerinde daha yukarıdadır."
                android:textSize="12sp"
                android:textColor="@color/on_surface_secondary" />

            <com.deniz0706.ykstakip.ui.statistics.LineChartView
                android:id="@+id/rankingChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />

            <TextView
                android:id="@+id/tvEmptyRankingChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_m"
                android:gravity="center"
                android:text="Sıralama trendi için henüz yeterli veri yok."
                android:textColor="@color/on_surface_secondary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

        </LinearLayout>
