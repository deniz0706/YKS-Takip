<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never restore an API-key ciphertext without its non-exportable Keystore key. -->
        <exclude domain="sharedpref" path="ai_secret_store.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- The API key must be entered again on a new device. -->
        <exclude domain="sharedpref" path="ai_secret_store.xml" />
    </device-transfer>
</data-extraction-rules>
