CREATE TABLE StudyDayRecord (
    studyDate TEXT NOT NULL PRIMARY KEY,
    questionCount INTEGER NOT NULL DEFAULT 0,
    studyMinutes INTEGER NOT NULL DEFAULT 0,
    estimated INTEGER NOT NULL DEFAULT 0
);

selectAllStudyDays:
SELECT * FROM StudyDayRecord
ORDER BY studyDate ASC;

selectStudyDay:
SELECT * FROM StudyDayRecord
WHERE studyDate = ?;

upsertStudyDay:
INSERT OR REPLACE INTO StudyDayRecord(studyDate, questionCount, studyMinutes, estimated)
VALUES (?, ?, ?, ?);

deleteStudyDay:
DELETE FROM StudyDayRecord
WHERE studyDate = ?;
