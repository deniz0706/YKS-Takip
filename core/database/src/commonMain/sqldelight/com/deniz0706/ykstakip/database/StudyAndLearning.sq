-- Offline-first records beyond the initial exam/study-day slice.
-- Photo paths stay as app-private file references; image bytes never enter SQLite.
CREATE TABLE LearningOutcomeRecord (
    id TEXT NOT NULL PRIMARY KEY,
    examType TEXT NOT NULL,
    subject TEXT NOT NULL,
    topic TEXT NOT NULL,
    title TEXT NOT NULL,
    completed INTEGER NOT NULL DEFAULT 0,
    reviewRequested INTEGER NOT NULL DEFAULT 0,
    wrongCount INTEGER NOT NULL DEFAULT 0,
    acknowledgedWrongCount INTEGER NOT NULL DEFAULT 0,
    nextReviewDate TEXT NOT NULL DEFAULT '',
    reviewLevel INTEGER NOT NULL DEFAULT 0,
    lastReviewedDate TEXT NOT NULL DEFAULT '',
    custom INTEGER NOT NULL DEFAULT 0,
    completedSubtopicsJson TEXT NOT NULL DEFAULT '[]',
    completedDate TEXT NOT NULL DEFAULT ''
);

CREATE TABLE QuestionCardRecord (
    id TEXT NOT NULL PRIMARY KEY,
    outcomeId TEXT NOT NULL,
    title TEXT NOT NULL DEFAULT '',
    notes TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL,
    createdAt TEXT NOT NULL,
    dueDate TEXT NOT NULL DEFAULT '',
    reviewCount INTEGER NOT NULL DEFAULT 0,
    photoPathsJson TEXT NOT NULL DEFAULT '[]',
    FOREIGN KEY (outcomeId) REFERENCES LearningOutcomeRecord(id) ON DELETE RESTRICT
);

CREATE INDEX QuestionCardRecord_outcomeId ON QuestionCardRecord(outcomeId);
CREATE INDEX QuestionCardRecord_dueDate ON QuestionCardRecord(dueDate);

selectAllLearningOutcomes:
SELECT * FROM LearningOutcomeRecord ORDER BY examType, subject, topic, id;

upsertLearningOutcome:
INSERT INTO LearningOutcomeRecord(
    id, examType, subject, topic, title, completed, reviewRequested,
    wrongCount, acknowledgedWrongCount, nextReviewDate, reviewLevel,
    lastReviewedDate, custom, completedSubtopicsJson, completedDate
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    examType = excluded.examType, subject = excluded.subject, topic = excluded.topic,
    title = excluded.title, completed = excluded.completed, reviewRequested = excluded.reviewRequested,
    wrongCount = excluded.wrongCount, acknowledgedWrongCount = excluded.acknowledgedWrongCount,
    nextReviewDate = excluded.nextReviewDate, reviewLevel = excluded.reviewLevel,
    lastReviewedDate = excluded.lastReviewedDate, custom = excluded.custom,
    completedSubtopicsJson = excluded.completedSubtopicsJson, completedDate = excluded.completedDate;

deleteLearningOutcome:
DELETE FROM LearningOutcomeRecord WHERE id = ?;

selectAllQuestionCards:
SELECT * FROM QuestionCardRecord ORDER BY createdAt, id;

selectQuestionsForOutcome:
SELECT * FROM QuestionCardRecord WHERE outcomeId = ? ORDER BY createdAt, id;

upsertQuestionCard:
INSERT INTO QuestionCardRecord(
    id, outcomeId, title, notes, status, createdAt, dueDate, reviewCount, photoPathsJson
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    outcomeId = excluded.outcomeId, title = excluded.title, notes = excluded.notes,
    status = excluded.status, createdAt = excluded.createdAt, dueDate = excluded.dueDate,
    reviewCount = excluded.reviewCount, photoPathsJson = excluded.photoPathsJson;

deleteQuestionCard:
DELETE FROM QuestionCardRecord WHERE id = ?;

-- A weekly plan's completedWeek is retained so old checkmarks do not
-- accidentally become permanent when the week changes.
CREATE TABLE StudyPlanRecord (
    id INTEGER NOT NULL PRIMARY KEY,
    dayOfWeek INTEGER NOT NULL,
    startTime TEXT NOT NULL,
    endTime TEXT NOT NULL,
    subject TEXT NOT NULL,
    topic TEXT NOT NULL DEFAULT '',
    completed INTEGER NOT NULL DEFAULT 0,
    completedWeek TEXT
);

CREATE INDEX StudyPlanRecord_day_start ON StudyPlanRecord(dayOfWeek, startTime);

selectAllStudyPlanItems:
SELECT * FROM StudyPlanRecord ORDER BY dayOfWeek, startTime, id;

upsertStudyPlanItem:
INSERT INTO StudyPlanRecord(
    id, dayOfWeek, startTime, endTime, subject, topic, completed, completedWeek
) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    dayOfWeek = excluded.dayOfWeek, startTime = excluded.startTime, endTime = excluded.endTime,
    subject = excluded.subject, topic = excluded.topic, completed = excluded.completed,
    completedWeek = excluded.completedWeek;

deleteStudyPlanItem:
DELETE FROM StudyPlanRecord WHERE id = ?;

-- Exactly one durable focus timer. startedAtEpochMillis is nullable when paused;
-- accumulatedMs and carry fields preserve sub-minute time across saves/restarts.
CREATE TABLE FocusTimerState (
    singletonId INTEGER NOT NULL PRIMARY KEY CHECK (singletonId = 1),
    durationMinutes INTEGER NOT NULL,
    accumulatedMs INTEGER NOT NULL DEFAULT 0,
    startedAtEpochMillis INTEGER,
    stopwatchMode INTEGER NOT NULL DEFAULT 0,
    carryDate TEXT,
    carryMs INTEGER NOT NULL DEFAULT 0
);

selectFocusTimerState:
SELECT * FROM FocusTimerState WHERE singletonId = 1;

upsertFocusTimerState:
INSERT INTO FocusTimerState(
    singletonId, durationMinutes, accumulatedMs, startedAtEpochMillis,
    stopwatchMode, carryDate, carryMs
) VALUES (1, ?, ?, ?, ?, ?, ?)
ON CONFLICT(singletonId) DO UPDATE SET
    durationMinutes = excluded.durationMinutes, accumulatedMs = excluded.accumulatedMs,
    startedAtEpochMillis = excluded.startedAtEpochMillis, stopwatchMode = excluded.stopwatchMode,
    carryDate = excluded.carryDate, carryMs = excluded.carryMs;

-- Exam-mode metadata and lap splits are separate from the single shared timer.
CREATE TABLE ExamSessionState (
    singletonId INTEGER NOT NULL PRIMARY KEY CHECK (singletonId = 1),
    examType TEXT NOT NULL,
    durationMinutes INTEGER NOT NULL,
    splitsJson TEXT NOT NULL DEFAULT '[]'
);

selectExamSessionState:
SELECT * FROM ExamSessionState WHERE singletonId = 1;

upsertExamSessionState:
INSERT INTO ExamSessionState(singletonId, examType, durationMinutes, splitsJson)
VALUES (1, ?, ?, ?)
ON CONFLICT(singletonId) DO UPDATE SET
    examType = excluded.examType, durationMinutes = excluded.durationMinutes,
    splitsJson = excluded.splitsJson;
