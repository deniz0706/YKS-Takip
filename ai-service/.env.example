# Required. Never commit real credentials.
NVIDIA_API_KEY=replace-with-server-side-nvidia-key
# Client bearer token accepted by this single-tenant MVP. Use a unique secret per deployment.
YKS_CLIENT_TOKEN=replace-with-long-random-client-token
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_DEFAULT_MODEL=mistralai/mistral-large-4-1t-a52b
AI_MAX_REQUESTS_PER_MINUTE=20
AI_UPSTREAM_TIMEOUT_SECONDS=75
